 "rounds": [
  {
   "round": "Online coding test",
   "tests": "DSA under time pressure, sometimes language or domain MCQs.",
   "prep": "Timed sets on the [ladder](../ladder/), and revise [patterns](../atlas/). Practise in the language the test allows."
  },
  {
   "round": "Aptitude test",
   "tests": "Arithmetic, logic, data interpretation and verbal reasoning at speed.",
   "prep": "Short daily timed sets. Learn when to skip a question."
  },
  {
   "round": "Technical interview",
   "tests": "Depth on your resume and fundamentals, plus live coding.",
   "prep": "Explain every resume line down to its internals, and answer drills out loud."
  },
  {
   "round": "Research discussion",
   "tests": "How you frame problems, read papers, design experiments and evaluate results.",
   "prep": "Prepare to walk through one project: hypothesis, baseline, metric, failure and what you would try next."
  },
  {
   "round": "Essay",
   "tests": "Motivation, clear writing and fit with the team's technical area.",
   "prep": "Write about a specific system you built and link it to the role's technical field. Use your own words and examples."
  },
  {
   "round": "Problem decomposition",
   "tests": "Breaking an ambiguous business problem into a scoped technical plan.",
   "prep": "Practise out loud: clarify the goal, choose a metric, list assumptions, propose the smallest useful system."
  },
  {
   "round": "Group discussion",
   "tests": "Structured reasoning and how you work with others.",
   "prep": "Make one clear point at a time, build on others' points and summarise near the end."
  },
  {
   "round": "HR or culture fit",
   "tests": "Motivation, ownership, teamwork and location or relocation fit.",
   "prep": "Prepare stories about a failure, a conflict and ownership. Research the company before each round."
  }
 ]
}
